<?xml version="1.0" encoding="utf-8"?>
<!-- 設定 → 端末情報 → ソフトウェア情報 のミニ図 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipChildren="false"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="10dp">

    <TextView style="@style/Text.MiniTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="@string/illus_software_info" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="4dp" android:paddingVertical="10dp">
        <TextView style="@style/Text.MiniRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/illus_oneui_version" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="4dp" android:paddingVertical="10dp">
        <TextView style="@style/Text.MiniRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/illus_android_version" />
        <TextView android:id="@+id/mini_android" style="@style/Text.MiniSub" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2dp"
        android:background="@drawable/bg_highlight"
        android:clipChildren="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/Text.MiniRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/illus_build_number" android:textStyle="bold" />
            <TextView android:id="@+id/mini_build" style="@style/Text.MiniSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxWidth="150dp" android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp"
            android:text="@string/illus_tap_7"
            android:textColor="@color/on_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-2dp"
            android:src="@drawable/ic_finger" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="4dp" android:paddingVertical="10dp">
        <TextView style="@style/Text.MiniRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/illus_se_status" />
    </LinearLayout>
</LinearLayout>
