    <!-- Setup guide -->
    <string name="guide_label">Setup  %1$d / %2$d</string>
    <string name="dev_title">Turn on\nDeveloper options</string>
    <string name="dev_step1">Tap the button below to open \"About phone\"</string>
    <string name="dev_step2">Tap \"Software information\"</string>
    <string name="dev_step3">Tap \"Build number\" 7 times in a row (enter your screen lock PIN if asked)</string>
    <string name="dev_step4">When you see \"Developer mode has been turned on\", come back to this app</string>
    <string name="dev_cta">Open About phone</string>
    <string name="wifi_title">Connect to Wi-Fi</string>
    <string name="wifi_lead">This app uses Galaxy\'s \"Wireless debugging\", which only works while you\'re connected to Wi-Fi. Your home or work Wi-Fi is fine.</string>
    <string name="wifi_step1">Tap the button below to open Wi-Fi settings</string>
    <string name="wifi_step2">Tap the Wi-Fi network you usually use</string>
    <string name="wifi_step3">Once connected, come back to this app</string>
    <string name="wifi_cta">Open Wi-Fi settings</string>
    <string name="pair_title">Pair, then silence\nthe shutter</string>
    <string name="pair_step1">Tap the button below to open \"Wireless debugging\" and turn it on (if asked to allow it on this network, tap \"Allow\")</string>
    <string name="pair_step2">Tap \"Pair device with pairing code\"</string>
    <string name="pair_step3">Swipe down from the top of the screen, type the 6-digit code into \"Enter code\", and send it</string>
    <string name="pair_step4">You\'re done when \"Done\" appears</string>
    <string name="pair_status_working">Setting up… Please wait.</string>
    <string name="pair_status_ready">Found the pairing screen. Enter the 6-digit code with \"Enter code\" in the notification.</string>
    <string name="pair_status_waiting">Waiting for the pairing screen to open.</string>
    <string name="pair_cta">Open Wireless debugging</string>
